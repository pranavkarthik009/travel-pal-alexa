{
  "interactionModel": {
    "languageModel": {
      "invocationName": "travel agent",
      "intents": [
        {
          "name": "PlanTripIntent",
          "slots": [
            {
              "name": "destination",
              "type": "AMAZON.SearchQuery",
              "samples": [
                "{destination}",
                "a trip to {destination}"
              ]
            },
            {
              "name": "days",
              "type": "AMAZON.NUMBER",
              "samples": [
                "for {days} days",
                "{days} days"
              ]
            },
            {
